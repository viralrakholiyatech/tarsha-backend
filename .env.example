PORT=7600

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET=tarsha-cloud-files

DB_PASSWORD=your_database_password
SMTP_PASSWORD=your_smtp_password
JWT_SECRET=your_jwt_secret
INSPECTION_SMTP_PASSWORD=your_inspection_smtp_password

# Hosted MySQL server reachable from Render (localhost is not your PC)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
MASTER_DB_NAME=master_admin

# Stable application secrets
SESSION_SECRET=replace_with_a_long_random_secret
AUTH_KEY=replace_with_your_auth_key
ENCRYPTION_KEY=replace_with_your_existing_encryption_key

# Optional: Firebase service-account JSON or a path to a secret file
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/serviceAccountKey.json
